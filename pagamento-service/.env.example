# Chave PÚBLICA do identidade-service — só valida tokens, nunca assina.
# Copie o mesmo conteúdo de jwt-public.pem em todos os serviços.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256

PORT=3004
DB_HOST=pagamento_db
DB_PORT=3306
DB_NAME=pagamento_db
DB_USER=root
DB_PASSWORD=troque_esta_senha_pagamento
REDIS_URL=redis://redis:6379
VENDAS_SERVICE_URL=http://vendas:3003
MERCADOPAGO_ACCESS_TOKEN=

# Token de serviço do VENDAS (o mesmo SERVICE_TOKEN do vendas-service): ler pedidos e confirmar o pagamento.
VENDAS_SERVICE_TOKEN=

# Gateway: mercadopago (padrão) ou simulado (aprova sem cobrar; SÓ para desenvolvimento).
GATEWAY_PAGAMENTO=mercadopago

# URL pública deste serviço, onde o Mercado Pago envia o webhook (ex.: https://loja.com/pagamento).
# Vazio = sem webhook (o Mercado Pago não alcança localhost; use um túnel como ngrok para testar).
PUBLIC_BASE_URL=

# URL do front-end, para onde o cliente volta depois de pagar (opcional).
FRONTEND_URL=

# Timeout das chamadas a outros serviços, em ms (opcional; padrão 5000)
# HTTP_TIMEOUT_MS=5000
# Espera entre tentativas de uma chamada repetível, em ms: 1ª espera = base, depois dobra (opcional; padrão 200)
# HTTP_BACKOFF_BASE_MS=200
# Circuit breaker por serviço chamado: quantas chamadas seguidas com falha abrem o circuito (padrão 5) e depois de
# quantos ms uma chamada de teste é liberada (padrão 10000). Aberto, a chamada é recusada na hora com 503.
# CIRCUIT_FALHAS=5
# CIRCUIT_RESET_MS=10000

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Métricas Prometheus em GET /metrics. Vazio = endpoint desligado (404).
METRICS_TOKEN=

# Origens permitidas no CORS, separadas por vírgula. Vazio = qualquer origem (só desenvolvimento).
CORS_ORIGINS=
# Limites por IP (opcionais; padrões abaixo)
# RATE_LIMIT_GERAL_MAX=600       (por minuto)
# RATE_LIMIT_PAGAMENTO_MAX=30    (POST /pagamentos e /sincronizar, por 15 min)
