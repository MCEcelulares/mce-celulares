PORT=3001
DB_HOST=identidade_db
DB_PORT=3306
DB_NAME=identidade_db
DB_USER=root
DB_PASSWORD=troque_esta_senha_identidade
REDIS_URL=redis://redis:6379

# Chave PRIVADA — só o identidade-service tem. Assina os tokens.
# Gere com: openssl genrsa -out jwt-private.pem 2048
# Cole o conteúdo do arquivo aqui com \n no lugar das quebras de linha.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_ALGORITHM=RS256
JWT_EXPIRES_IN=1h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
