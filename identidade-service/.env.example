PORT=3001

DB_HOST=identidade_db
DB_PORT=3306
DB_NAME=identidade_db
DB_USER=root
DB_PASSWORD=troque_esta_senha_identidade

# Redis (guarda os refresh tokens — ADR-007)
REDIS_URL=redis://redis:6379

# Chave PRIVADA RS256 — só o identidade-service tem (ADR-005).
# Cole o conteúdo de keys/jwt-private.pem com quebras de linha reais, entre aspas.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
JWT_ALGORITHM=RS256
# Access token curto: permissões e cargos só mudam no próximo refresh (ADR-006). Recomendado: 15m
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DIAS=7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Primeiro administrador (criado por `npm run seed`; ignorado se o e-mail já existir)
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=troque_esta_senha_do_admin

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Métricas Prometheus em GET /metrics. Vazio = endpoint desligado (404).
METRICS_TOKEN=

# Limites por IP (opcionais; padrões abaixo)
# RATE_LIMIT_LOGIN_MAX=10        (por 15 min)
# RATE_LIMIT_CADASTRO_MAX=20     (por 1 hora)

