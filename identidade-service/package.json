    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
