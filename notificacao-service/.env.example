# Chave PÚBLICA do identidade-service — só valida tokens, nunca assina.
# Copie o mesmo conteúdo de jwt-public.pem em todos os serviços.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256

PORT=3005
DB_HOST=notificacao_db
DB_PORT=3306
DB_NAME=notificacao_db
DB_USER=root
DB_PASSWORD=troque_esta_senha_notificacao
REDIS_URL=redis://redis:6379
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_CONTATO_LOJA=
EMAIL_REMETENTE=MCE Celulares <nao-responda@seudominio.com>

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Métricas Prometheus em GET /metrics. Vazio = endpoint desligado (404).
METRICS_TOKEN=

# Limite por IP do POST /contato (opcional; padrão abaixo)
# RATE_LIMIT_CONTATO_MAX=5       (por 1 hora)

# Pausa base entre tentativas de envio de e-mail, em ms (opcional; padrão 500)
# EMAIL_RETRY_MS=500

# Pausa mínima entre envios de e-mail, em ms (opcional; padrão 0). Mailtrap grátis: ~1100
# EMAIL_INTERVALO_MS=0
