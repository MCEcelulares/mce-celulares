# Chave PÚBLICA do identidade-service — só valida tokens, nunca assina.
# Copie o mesmo conteúdo de jwt-public.pem em todos os serviços.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256

PORT=3003
DB_HOST=vendas_db
DB_PORT=3306
DB_NAME=vendas_db
DB_USER=root
DB_PASSWORD=troque_esta_senha_vendas
REDIS_URL=redis://redis:6379
IDENTIDADE_SERVICE_URL=http://identidade:3001
CATALOGO_SERVICE_URL=http://catalogo:3002

# Token que o Pagamento usa para chamar PATCH /pedidos/{id}/status. Vazio = só JWT com permissão.
SERVICE_TOKEN=

# Token de serviço do CATÁLOGO (o mesmo SERVICE_TOKEN do catalogo-service), para baixar/repor estoque.
CATALOGO_SERVICE_TOKEN=

# Timeout das chamadas a outros serviços, em ms (opcional; padrão 5000)
# HTTP_TIMEOUT_MS=5000

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Métricas Prometheus em GET /metrics. Vazio = endpoint desligado (404).
METRICS_TOKEN=
