# Chave PÚBLICA do identidade-service — só valida tokens, nunca assina.
# Copie o mesmo conteúdo de jwt-public.pem em todos os serviços.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256

PORT=3002
DB_HOST=catalogo_db
DB_PORT=3306
DB_NAME=catalogo_db
DB_USER=root
DB_PASSWORD=troque_esta_senha_catalogo
REDIS_URL=redis://redis:6379
CACHE_TTL_SEGUNDOS=300

# Token das rotas internas (ex.: Vendas baixando estoque). Vazio = rotas internas desligadas (404).
SERVICE_TOKEN=

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Métricas Prometheus em GET /metrics. Vazio = endpoint desligado (404).
METRICS_TOKEN=

# Imagens de produto (RF15): pasta no disco (em Docker é um volume) e URL pública sob a qual o gateway as serve.
# UPLOADS_DIR=/app/uploads
# IMAGENS_URL_BASE=/catalogo/imagens

# Origens permitidas no CORS, separadas por vírgula. Vazio = qualquer origem (só desenvolvimento).
CORS_ORIGINS=
# Limites por IP (opcionais; padrões abaixo)
# RATE_LIMIT_GERAL_MAX=1000      (por minuto; alto porque o Vendas consulta o Catálogo a cada item)
# RATE_LIMIT_UPLOAD_MAX=30       (envio de imagem, por 15 min)
