# Chave PÚBLICA do identidade-service — só valida tokens, nunca assina (ADR-005).
# Cole o valor gerado por keys/generate-jwt-keys.js (o mesmo em todos os serviços).
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256

PORT=3002

DB_HOST=catalogo_db
DB_PORT=3306
DB_NAME=catalogo_db
DB_USER=root
DB_PASSWORD=troque_esta_senha_catalogo

# Redis (cache-aside de produtos/categorias/marcas — ADR-008)
REDIS_URL=redis://redis:6379
CACHE_TTL_SEGUNDOS=300

# Token de serviço das rotas /interno (reserva de estoque — ADR-009).
# O Vendas envia o MESMO valor no header x-service-token. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=troque_este_token_de_servico

# Imagens dos produtos (ADR-010). No Docker é um volume; local pode ser ./uploads
UPLOAD_DIR=/app/uploads
# Prefixo público das imagens (passa pelo nginx em /catalogo/)
IMAGENS_URL_BASE=/catalogo/imagens

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Métricas Prometheus em GET /metrics. Vazio = endpoint desligado (404).
METRICS_TOKEN=
